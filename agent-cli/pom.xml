<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.agentharness</groupId>
    <artifactId>java-agent-sdk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>agent-cli</artifactId>
  <name>agent-cli</name>
  <description>命令行入口 —— D 节四个模块各自一个子命令，可分别拉起为独立进程</description>

  <dependencies>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-tui</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-keys</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-store</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-comm</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-task</artifactId>
    </dependency>
    <dependency>
      <groupId>io.agentharness</groupId>
      <artifactId>agent-tools</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>agent</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.agentharness.cli.AgentCli</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
